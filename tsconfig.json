{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "examples",
    "tests",
    "e2e",
    "unit",
    "visual",
    "playwright.visual.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
