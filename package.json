{
  "name": "@soheab-com/liquid-glass-navbar",
  "version": "1.0.0",
  "description": "An iOS-style Liquid Glass tab bar in plain TypeScript and CSS, with a sliding lens, swipe gestures and overflow.",
  "license": "MPL-2.0",
  "author": "Soheab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soheab-com/liquid-glass-navbar.git"
  },
  "homepage": "https://soheab.com/navbar-builder/docs/",
  "bugs": {
    "url": "https://github.com/soheab-com/liquid-glass-navbar/issues"
  },
  "keywords": [
    "liquid glass",
    "liquid-glass",
    "tab bar",
    "tabbar",
    "navbar",
    "navigation",
    "ios",
    "glassmorphism",
    "react",
    "vue"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./navbar.css": "./dist/navbar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "demo": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "test:ssr": "node tests/ssr.mjs",
    "prepack": "npm run build",
    "perf": "node scripts/perf.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:links": "node scripts/check-links.mjs",
    "size": "size-limit",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "esbuild": "0.28.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.2",
    "vue": "^3.5.46"
  }
}
