{
  "name": "@soheab-com/liquid-glass-navbar",
  "version": "0.12.0",
  "description": "An iOS-style Liquid Glass tab bar in plain TypeScript and CSS, with a sliding lens, swipe gestures and overflow.",
  "license": "MIT",
  "author": "Soheab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soheab-com/liquid-glass-navbar.git"
  },
  "homepage": "https://soheab.com/navbar-builder/docs/",
  "bugs": {
    "url": "https://github.com/soheab-com/liquid-glass-navbar/issues"
  },
  "keywords": [
    "liquid glass",
    "liquid-glass",
    "tab bar",
    "tabbar",
    "navbar",
    "navigation",
    "ios",
    "glassmorphism"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./navbar.css": "./dist/navbar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "demo": "esbuild examples/demo.ts examples/features.ts examples/catalog.ts tests/rows-lens.ts tests/more-tap.ts tests/hover-navigation.ts tests/catalog-rows.ts --bundle --format=esm --outdir=. --outbase=. --servedir=. --serve=127.0.0.1:4173",
    "build": "node scripts/build.mjs",
    "test:ssr": "node tests/ssr.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
